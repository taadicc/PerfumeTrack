<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
	fx:controller="gui.KreiranjeRacunaController" prefWidth="850"
	prefHeight="650" style="-fx-background-color: #f8f9fa;">
	<fx:define>
		<ToggleGroup fx:id="nacinPlacanjaGroup" />
	</fx:define>

	<top>
		<VBox spacing="15"
			style="-fx-padding: 20 25 15 25; -fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
			<Label text="Kreiranje računa"
				style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" />
		</VBox>
	</top>

	<center>
		<VBox spacing="20" style="-fx-padding: 20 25;">

			<VBox spacing="15"
				style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

				<Label text="Dodavanje stavke"
					style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #495057;" />

				<GridPane hgap="15" vgap="12">
					<columnConstraints>
						<ColumnConstraints minWidth="80" prefWidth="80" />
						<ColumnConstraints minWidth="280"
							prefWidth="280" />
						<ColumnConstraints minWidth="80" prefWidth="80" />
						<ColumnConstraints minWidth="120"
							prefWidth="120" />
					</columnConstraints>

					<Label text="Proizvod:" GridPane.columnIndex="0"
						GridPane.rowIndex="0"
						style="-fx-font-weight: bold; -fx-text-fill: #6c757d;" />
					<ComboBox fx:id="proizvodComboBox"
						GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="280"
						style="-fx-font-size: 13px;" />

					<Label text="Količina:" GridPane.columnIndex="2"
						GridPane.rowIndex="0"
						style="-fx-font-weight: bold; -fx-text-fill: #6c757d;" />
					<TextField fx:id="kolicinaField" GridPane.columnIndex="3"
						GridPane.rowIndex="0" prefWidth="120" promptText="0"
						style="-fx-font-size: 13px;" />
				</GridPane>

				<HBox alignment="CENTER_LEFT">
					<Button text="➕ Dodaj na račun"
						onAction="#dodajStavkuNaRacun"
						style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 6; -fx-font-weight: bold;" />
				</HBox>
			</VBox>

			<VBox spacing="12"
				style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

				<Label text="Stavke računa"
					style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #495057;" />

				<TableView fx:id="stavkeTable" prefHeight="280"
					style="-fx-border-color: #dee2e6; -fx-border-radius: 4;">
					<placeholder>
						<Label text="Nema dodanih stavki"
							style="-fx-text-fill: #6c757d; -fx-font-style: italic;" />
					</placeholder>
				</TableView>
			</VBox>

			<HBox spacing="25" alignment="CENTER_LEFT"
				style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

				<VBox spacing="12" prefWidth="300">
					<Label text="Lojalti kartica"
						style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #495057;" />

					<HBox spacing="10" alignment="CENTER_LEFT">
						<Label text="ID kartice:" minWidth="70"
							style="-fx-font-weight: bold; -fx-text-fill: #6c757d;" />
						<TextField fx:id="karticaIdField"
							promptText="Opcionalno" prefWidth="150"
							style="-fx-font-size: 13px;" />
					</HBox>

					<Label fx:id="bodoviLabel" text="Bodovi: -"
						style="-fx-font-size: 13px; -fx-text-fill: #6c757d;" />

					<HBox spacing="8" alignment="CENTER_LEFT">
						<CheckBox fx:id="koristiBodoveCheckBox" />
						<Label text="Koristi bodove za popust"
							style="-fx-font-size: 13px; -fx-text-fill: #6c757d;" />
					</HBox>
				</VBox>

				<VBox spacing="12" prefWidth="200">
					<Label text="Način plaćanja"
						style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #495057;" />

					<RadioButton text="Gotovina"
						toggleGroup="$nacinPlacanjaGroup" selected="true"
						style="-fx-font-size: 13px;" />
					<RadioButton text="Kartica"
						toggleGroup="$nacinPlacanjaGroup" style="-fx-font-size: 13px;" />
				</VBox>


				<Region HBox.hgrow="ALWAYS" />

				<VBox spacing="10" alignment="CENTER_RIGHT" minWidth="250">
					<Label fx:id="ukupnoLabel" text="Ukupno: 0.00 KM"
						style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #007bff;" />

					<Label fx:id="popustBodoviLabel"
						text="Popust od bodova: 0.00 KM"
						style="-fx-font-size: 13px; -fx-text-fill: #28a745;" />

					<Separator prefWidth="220"
						style="-fx-background-color: #dee2e6;" />

					<Label fx:id="finalnaCijenaLabel"
						text="Finalna cijena: 0.00 KM"
						style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #dc3545;" />

					<Region prefHeight="10" />

					<Button text="💾 Završi prodaju" onAction="#zavrsiProdaju"
						style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 12 25; -fx-background-radius: 6; -fx-font-weight: bold;"
						prefWidth="180" />
				</VBox>
			</HBox>
		</VBox>
	</center>
</BorderPane>