<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
	fx:controller="gui.BrendoviController" prefWidth="750" prefHeight="550">

	<top>
		<VBox spacing="15" style="-fx-padding: 20;">
			<Label text="Lista brendova"
				style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" />

			<HBox spacing="10" alignment="CENTER_LEFT">
				<Button text="Dodaj novi brend" onAction="#dodajBrend"
					style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 4;" />

				<Button text="Obriši brend" onAction="#obrisiBrend"
					style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 4;" />

				<Button text="Osvježi" onAction="#ucitajBrendove"
					style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 4;" />

			</HBox>

		</VBox>
	</top>

	<center>
		<VBox style="-fx-padding: 0 20 20 20;">
			<TableView fx:id="tableBrendovi" prefHeight="400">
				<columns>
					<TableColumn fx:id="colId" text="ID brenda"
						prefWidth="100" />
					<TableColumn fx:id="colNaziv" text="Naziv brenda"
						prefWidth="220" />
					<TableColumn fx:id="colOpis" text="Opis brenda"
						prefWidth="400" />
				</columns>
			</TableView>
		</VBox>
	</center>

</BorderPane>